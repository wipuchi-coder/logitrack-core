# Base PostgreSQL interna de Compose.
POSTGRES_DB=logitrack
POSTGRES_USER=logitrack
POSTGRES_PASSWORD=REEMPLAZA_PASSWORD_POSTGRES
# Cuenta operadora y firma JWT. Usa 12 caracteres como mínimo para la cuenta y 32 bytes para la firma.
WMS_USERNAME=operator
WMS_PASSWORD=REEMPLAZA_PASSWORD_WMS
JWT_SECRET=REEMPLAZA_SECRETO_ALEATORIO_JWT
# Puertos locales y orígenes de navegador separados por comas.
WMS_PORT=8080
ANALYTICS_PORT=8000
CORS_ORIGINS=http://localhost:3000
